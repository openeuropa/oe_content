{
    "name": "openeuropa/oe_content",
    "description": "OpenEuropa Drupal module that contains the EC corporate entity types.",
    "type": "drupal-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "cweagans/composer-patches": "^1.7 || ^2.0",
        "drupal/core": "^10 || ^11",
        "drupal/datetime_range_timezone": "^1.0.0-alpha3",
        "drupal/linkit": "^7.0.11",
        "drupal/maxlength": "^3.0.0-beta1",
        "drupal/rdf_skos": "^1.3",
        "drupal/backport_node_storage_body_field": "^1 || ^2",
        "openeuropa/oe_media": "^1.23.1"
    },
    "require-dev": {
        "composer/installers": "^1.5 || ^2.3",
        "drupal/address": "^1.11 || ^2.0",
        "drupal/composite_reference": "^2.2",
        "drupal/config_devel": "^1.9",
        "drupal/core-composer-scaffold": "^10 || ^11",
        "drupal/core-dev": "^10 || ^11",
        "drupal/datetime_testing": "^1.0",
        "drupal/description_list_field": "^1.0.0-alpha5",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_reference_revisions": "^1.8",
        "drupal/field_group": "^4.0",
        "drupal/inline_entity_form": "^1.0-rc15 || ^3.0@RC",
        "drupal/token": "^1.10",
        "drupal/typed_link": "^2.1",
        "drush/drush": "^12.4 || ^13",
        "ec-europa/toolkit": "^10.23",
        "openeuropa/code-review-drupal": "^1.0.0-alpha",
        "openeuropa/oe_corporate_countries": "^2.3",
        "openeuropa/oe_corporate_site_info": "^1.2",
        "openeuropa/oe_link_lists": "^1.8",
        "openeuropa/oe_multilingual": "^1.18",
        "openeuropa/oe_time_caching": "^1.8",
        "openeuropa/oe_testing_utils": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\oe_content\\": "./src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "build/core/modules/field/tests/src/Traits/EntityReferenceFieldCreationTrait.php"
        ],
        "psr-4": {
            "Drupal\\Tests\\oe_content\\": "./tests/src/",
            "Drupal\\Tests\\oe_content_featured_media_field\\": "./modules/oe_content_featured_media_field/tests/src/",
            "Drupal\\Tests\\oe_media\\": "./build/modules/contrib/oe_media/tests/src/"
        }
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "installer-paths": {
            "build/core": ["type:drupal-core"],
            "build/profiles/contrib/{$name}": ["type:drupal-profile"],
            "build/modules/contrib/{$name}": ["type:drupal-module"],
            "build/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "patches": {
            "drupal/entity_browser": {
                "https://www.drupal.org/project/entity_browser/issues/2851580": "https://www.drupal.org/files/issues/2026-08-12/2851580-38-20260812.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ec-europa/toolkit-composer-plugin": true,
            "enable-patching": true,
            "openeuropa/composer-dependent-patches": true,
            "php-http/discovery": false,
            "phpro/grumphp": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": false
        }
    }
}
